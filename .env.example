# Values are available from the Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SECRET_KEY=your-server-only-secret-key

# Server-only. Verify the sender domain in Resend before enabling delivery.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=FixxFlow <notifications@your-verified-domain.com>
CRON_SECRET=
