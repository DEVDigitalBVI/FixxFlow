# Values are available from the Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SECRET_KEY=your-server-only-secret-key

# Server-only. Verify fixxflow.app in Resend; keep the support mailbox MX at Zoho.
# Use a Resend API key with sending access to the verified domain.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=FixxFlow <notifications@fixxflow.app>
CRON_SECRET=

# Server-only bearer credential for /api/health/ready; also a GitHub Production secret.
HEALTH_CHECK_SECRET=
# Operational setup only: store in GitHub's Production environment for Better Stack.
# Not required by the application runtime; never use a NEXT_PUBLIC_ prefix.
BETTER_STACK_UPTIME_API_TOKEN=

# Deployment gate only; the owner-controlled database activation gate must also
# be enabled explicitly. Keep both OFF until pre-production checks are complete.
AUTOMATION_PROCESSING_ENABLED=false

# Email to ticket (Resend inbound). All three must be set to enable it.
RESEND_INBOUND_WEBHOOK_SECRET=
INBOUND_EMAIL_DOMAIN=in.fixxflow.app
