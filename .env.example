# Values are available from the Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SECRET_KEY=your-server-only-secret-key

# Server-only. Verify fixxflow.app in Resend; keep the support mailbox MX at Zoho.
# Use a Resend API key with sending access to the verified domain.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=FixxFlow <notifications@fixxflow.app>
CRON_SECRET=

# Deployment gate only; the owner-controlled database activation gate must also
# be enabled explicitly. Keep both OFF until pre-production checks are complete.
AUTOMATION_PROCESSING_ENABLED=false
