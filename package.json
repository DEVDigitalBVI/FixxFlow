{
  "name": "fixxflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"src/**/*.test.mjs\"",
    "test:build": "node scripts/verify-proxy-build.mjs && node scripts/verify-paint-build.mjs",
    "test:database": "node scripts/test-database.mjs",
    "test:smoke": "node scripts/smoke-deployment.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "brand:sync": "node scripts/sync-brand-assets.mjs",
    "brand:check": "node scripts/sync-brand-assets.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "visual:capture": "node scripts/visual-compare.mjs capture",
    "visual:compare": "node scripts/visual-compare.mjs compare",
    "db:types": "node scripts/generate-database-types.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.4.5",
    "pdf-lib": "1.17.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.8",
    "tailwind-merge": "3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-pgtap": "0.0.16",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "eslint": "$eslint"
  }
}
