      "guidance": "Use Inter for all product text: 400 for body, 500 for labels and controls, 600 for headings and emphasis. The variable family and its OFL license are self-hosted."
    },
    "wordmark": {
      "guidance": "The wordmark is artwork. Do not recreate it using live text."
    },
    "heading": {
      "fontFamily": {
        "$value": "Inter, ui-sans-serif, system-ui, sans-serif",
        "$type": "fontFamily"
      }
    }
