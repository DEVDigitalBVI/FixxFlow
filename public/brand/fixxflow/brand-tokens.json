{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "name": "FixxFlow",
    "tagline": "IT SUPPORT IN MOTION"
  },
  "color": {
    "brand": {
      "yellow": {
        "$value": "#FFD700",
        "$type": "color"
      },
      "gray": {
        "$value": "#ADB5BD",
        "$type": "color"
      },
      "link": {
        "$value": "#212529",
        "$type": "color"
      },
      "soft": {
        "$value": "#FFF4B3",
        "$type": "color"
      },
      "ink": {
        "$value": "#212529",
        "$type": "color"
      },
      "orange": {
        "$value": "#FF9800",
        "$type": "color"
      }
    },
    "surface": {
      "canvas": {
        "$value": "#FAF9F2",
        "$type": "color"
      },
      "card": {
        "$value": "#ffffff",
        "$type": "color"
      },
      "dark": {
        "$value": "#212529",
        "$type": "color"
      }
    },
    "text": {
      "primary": {
        "$value": "#212529",
        "$type": "color"
      },
      "secondary": {
        "$value": "#545b62",
        "$type": "color"
      },
      "inverse": {
        "$value": "#ffffff",
        "$type": "color"
      }
    },
    "border": {
      "subtle": {
        "$value": "#dee2e6",
        "$type": "color"
      }
    },
    "status": {
      "info": {
        "$value": "#ffd700",
        "$type": "color"
      },
      "success": {
        "$value": "#343a40",
        "$type": "color"
      },
      "warning": {
        "$value": "#8A4B00",
        "$type": "color"
      },
      "critical": {
        "$value": "#212529",
        "$type": "color"
      },
      "inactive": {
        "$value": "#545b62",
        "$type": "color"
      }
    }
  },
  "typography": {
    "ui": {
      "fontFamily": {
        "$value": "Outfit, ui-sans-serif, system-ui, sans-serif",
        "$type": "fontFamily"
      },
      "guidance": "Use Outfit 400 for body and 500 for regular labels. Use Rethink Sans 600 for controls/section headings and 700 for major headings and bold text. Both variable families and OFL licenses are included and self-hosted."
    },
    "wordmark": {
      "guidance": "The wordmark is artwork. Do not recreate it using live text."
    },
    "heading": {
      "fontFamily": {
        "$value": "Rethink Sans, ui-sans-serif, system-ui, sans-serif",
        "$type": "fontFamily"
      }
    }
  }
}
